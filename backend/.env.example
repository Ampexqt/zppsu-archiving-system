# Database Connection URL (PostgreSQL)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zppsu_archiving_db"

# Server Port
PORT=5000

# Authentication Secret Key (Used to securely sign user session tokens)
JWT_SECRET=supersecret_jwt_key_change_me_in_production

# Email Service Configuration (Optional: for password recovery OTP notifications)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
