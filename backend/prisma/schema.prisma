generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       String   @default("User")
  created_at DateTime @default(now())

  logs  logs[]
  files files[]
}

model categories {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
}

model files {
  id            Int      @id @default(autoincrement())
  title         String
  category      String
  file_name     String?
  file_path     String?
  uploaded_by   Int?
  file_box_id   Int?
  access_code   String?
  subject       String?
  document_type String?
  file_type     String?
  is_generated  Boolean @default(false)
  generated_type String?
  dynamic_data  Json?
  ocr_text      String?
  document_id   String?
  memo_date     DateTime?
  received_date DateTime?
  created_at    DateTime @default(now())
  status        String? @default("Active")
  is_deleted    Boolean @default(false)

  user users? @relation(fields: [uploaded_by], references: [id])

  file_box file_boxes? @relation("FileBoxFiles", fields: [file_box_id], references: [id])
}

model logs {
  id          Int      @id @default(autoincrement())
  action      String
  description String
  user_id     Int?
  created_at  DateTime @default(now())

  user users? @relation(fields: [user_id], references: [id])
}

model cabinets {
  id            Int      @id @default(autoincrement())
  name          String
  capacity      Int
  status        String
  created_at    DateTime @default(now())

  file_boxes    file_boxes[] @relation("CabinetFileBoxes")
}

model file_boxes {
  id            Int      @id @default(autoincrement())
  name          String
  cabinet_id    Int
  capacity      Int
  used_space    Int @default(0)
  status        String
  created_at    DateTime @default(now())

  cabinet       cabinets @relation("CabinetFileBoxes", fields: [cabinet_id], references: [id])
  files         files[] @relation("FileBoxFiles")
}